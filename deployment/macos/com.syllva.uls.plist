<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.syllva.uls</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/TO/venv/bin/uls</string>
    <string>--config</string><string>/ABSOLUTE/PATH/TO/config.yaml</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/Syllva</string>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TO/uls-status.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/uls-error.log</string>
</dict></plist>
