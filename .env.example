# University Learning System — secret environment variables
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Secrets are never stored in committed config, Skills, ChatGPT instructions, or logs.
#
# Credential separation (spec §23 / §27):
#   - Worker credentials may be write-capable (background/local processing only).
#   - MCP retrieval credentials MUST be separate read-only credentials/scopes
#     where the provider supports it.

# --- Google Drive ---
# Worker credential: Drive read/write (background ingestion/archive/derivatives)
GOOGLE_WORKER_CREDENTIALS_FILE=
# MCP retrieval credential: Drive read-only where supported
GOOGLE_MCP_CREDENTIALS_FILE=

# --- Notion ---
# Worker token: Notion read/write
NOTION_WORKER_TOKEN=
# MCP retrieval token: Notion read-only where supported
NOTION_MCP_TOKEN=

# --- GitHub ---
# Read-only token for exact-ref project source retrieval
GITHUB_READ_TOKEN=

# --- LLM (enrichment + optional bounded rerank) ---
LLM_API_KEY=

# --- Remote MCP ---
# Development-only short-lived bearer secret over TLS.
# Prefer OAuth/OIDC. Never long-lived. Never logged. Never embedded in Skills.
REMOTE_MCP_SECRET=
